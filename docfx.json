{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
        "_appName": "Resultron",
        "_appTitle": "Resultron",
        "_appLogoPath": "docs/images/logo.png",
        "_appFaviconPath": "docs/images/logo.png",
        "_appFooter": "© 2026 Resultron. Licensed under MIT.",
        "_enableSearch": true,
        "pdf": false,
        "_gitContribute": {
            "repo": "https://github.com/ferdikurnazdm/Resultron",
            "branch": "main"
        }
    }
  }
}